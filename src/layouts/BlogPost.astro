---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { enrichBlogEntry } from '../utils/blogHelpers';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const enrichedData = enrichBlogEntry(post);
const { title, description, pubDate, updatedDate, tags } = enrichedData;

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'America/Los_Angeles',
});

const formattedUpdateDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'America/Los_Angeles',
});
---

<BaseLayout title={`${title} | Blog`} description={description}>
  <article class="blog-post" data-pagefind-body>
    <header class="post-header">
      <div class="container">
        <a href="/blog/" class="back-link">&larr; Back to Blog</a>
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          {updatedDate && (
            <div class="updated">
              Last edited on <time datetime={updatedDate.toISOString()}>{formattedUpdateDate}</time>
            </div>
          )}
        </div>
        <div class="tags">
          {tags.map((tag) => (
            <a href={`/blog/tags/${tag}/`} class="tag">{tag}</a>
          ))}
        </div>
      </div>
    </header>
    <div class="post-content container">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding-bottom: 4rem;
  }

  .post-header {
    padding: 4rem 0 2rem;
    background: var(--bg-secondary);
    margin-bottom: 3rem;
  }

  .back-link {
    display: inline-block;
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #1d4ed8;
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .post-meta {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .updated {
    margin-top: 0.25rem;
    opacity: 0.8;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post-content {
    max-width: 750px;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .post-content :global(h3) {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
    line-height: 1.8;
    color: var(--text-primary);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .post-content :global(pre) {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border-color);
  }

  .post-content :global(code) {
    font-family: 'SF Mono', 'Fira Code', 'Fira Mono', monospace;
    font-size: 0.9rem;
  }

  .post-content :global(p code) {
    background: var(--bg-secondary);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--primary-color);
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    background: var(--bg-secondary);
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--primary-color);
    text-decoration: underline;
  }

  .post-content :global(a:hover) {
    color: #1d4ed8;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 2rem;
    }
  }
</style>

<style is:global>
  .post-content .inference-diagram {
    width: min(92vw, 920px);
    margin: 2.75rem 0 3rem 50%;
    transform: translateX(-50%);
    border: 1px solid #334155;
    border-radius: 8px;
    background:
      linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(30, 41, 59, 0.92)),
      radial-gradient(circle at 15% 18%, rgba(56, 189, 248, 0.16), transparent 32%),
      radial-gradient(circle at 82% 78%, rgba(245, 158, 11, 0.12), transparent 30%);
    box-shadow: 0 24px 60px rgba(2, 6, 23, 0.38);
    overflow: hidden;
  }

  .post-content .inference-diagram * {
    box-sizing: border-box;
  }

  .post-content .inference-diagram p {
    margin: 1rem 0 0;
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .inference-diagram__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    color: #e2e8f0;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.85rem;
    letter-spacing: 0;
  }

  .inference-diagram__header span:first-child {
    color: #f8fafc;
    font-weight: 700;
  }

  .inference-diagram__header span:last-child {
    color: #94a3b8;
    text-align: right;
  }

  .inference-phase-grid,
  .hardware-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: rgba(148, 163, 184, 0.16);
  }

  .inference-panel,
  .hardware-panel {
    min-width: 0;
    padding: 1.25rem;
    background: rgba(15, 23, 42, 0.86);
  }

  .phase-kicker {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    margin-bottom: 1rem;
    padding: 0.35rem 0.65rem;
    border: 1px solid rgba(56, 189, 248, 0.32);
    border-radius: 999px;
    color: #7dd3fc;
    background: rgba(14, 165, 233, 0.08);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .prompt-token-row,
  .generated-token-row,
  .request-queue,
  .gpu-output,
  .fast-token-stream {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .prompt-token-row span,
  .generated-token-row span,
  .request-queue span,
  .gpu-output span,
  .fast-token-stream span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 3.25rem;
    min-height: 1.65rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 6px;
    color: #e2e8f0;
    background: rgba(30, 41, 59, 0.9);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.72rem;
    line-height: 1;
    animation: inferenceTokenPulse 4.8s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * 0.18s);
  }

  .prefill-machine {
    display: grid;
    grid-template-columns: minmax(90px, 1fr) 128px 112px;
    align-items: center;
    gap: 0.75rem;
    min-height: 132px;
    margin-top: 1rem;
  }

  .parallel-lanes {
    position: relative;
    min-height: 104px;
    border-left: 1px solid rgba(56, 189, 248, 0.34);
    border-right: 1px solid rgba(56, 189, 248, 0.18);
  }

  .parallel-lanes span {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(12px + var(--i, 0) * 18px);
    height: 2px;
    background: linear-gradient(90deg, rgba(56, 189, 248, 0.15), rgba(56, 189, 248, 0.75), rgba(56, 189, 248, 0.12));
    overflow: visible;
  }

  .parallel-lanes span::after {
    content: "";
    position: absolute;
    top: -4px;
    left: 0;
    width: 24px;
    height: 10px;
    border-radius: 999px;
    background: #38bdf8;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.76);
    animation: prefillPacket 2.4s linear infinite;
    animation-delay: calc(var(--i, 0) * 0.12s);
  }

  .transformer-core,
  .decode-core,
  .prefill-node,
  .wafer-engine {
    position: relative;
    min-height: 104px;
    padding: 0.85rem;
    border: 1px solid rgba(125, 211, 252, 0.26);
    border-radius: 8px;
    background: linear-gradient(180deg, rgba(30, 41, 59, 0.96), rgba(15, 23, 42, 0.96));
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    animation: inferenceBreathe 4s ease-in-out infinite;
  }

  .transformer-core > span,
  .decode-core > span,
  .prefill-node > span,
  .wafer-engine > span,
  .kv-cache-block > span,
  .decode-cache > span,
  .gpu-label {
    display: block;
    color: #f8fafc;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .core-grid,
  .wafer-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.28rem;
    margin-top: 0.75rem;
  }

  .core-grid i,
  .wafer-grid i {
    display: block;
    aspect-ratio: 1;
    border-radius: 3px;
    background: rgba(56, 189, 248, 0.2);
    border: 1px solid rgba(56, 189, 248, 0.22);
    animation: computeCell 1.8s ease-in-out infinite;
  }

  .core-grid i:nth-child(3n),
  .wafer-grid i:nth-child(3n) {
    animation-delay: 0.35s;
  }

  .core-grid i:nth-child(4n),
  .wafer-grid i:nth-child(4n) {
    animation-delay: 0.65s;
  }

  .kv-cache-block,
  .decode-cache {
    min-height: 104px;
    padding: 0.85rem;
    border: 1px solid rgba(34, 197, 94, 0.28);
    border-radius: 8px;
    background: rgba(20, 83, 45, 0.16);
  }

  .kv-cache-block i,
  .decode-cache i {
    display: block;
    height: 8px;
    margin-top: 0.48rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #22c55e, #a3e635);
    transform: scaleX(0.24);
    transform-origin: left;
    animation: kvCacheFill 3s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * 0.16s);
  }

  .decode-machine {
    position: relative;
    display: grid;
    grid-template-columns: minmax(96px, 0.85fr) minmax(132px, 1.15fr);
    gap: 0.75rem;
    min-height: 190px;
  }

  .decode-core {
    overflow: hidden;
  }

  .decode-core b {
    position: absolute;
    inset: auto 1rem 1rem auto;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 18px rgba(245, 158, 11, 0.72);
    animation: decodeStepPulse 1.2s ease-in-out infinite;
  }

  .decode-loop-line {
    position: absolute;
    left: 17%;
    right: 17%;
    top: 112px;
    height: 38px;
    border-right: 2px solid rgba(245, 158, 11, 0.7);
    border-bottom: 2px solid rgba(245, 158, 11, 0.7);
    border-left: 2px solid rgba(245, 158, 11, 0.7);
    border-radius: 0 0 16px 16px;
    opacity: 0.7;
    animation: loopGlow 1.8s ease-in-out infinite;
  }

  .generated-token-row {
    grid-column: 1 / -1;
    align-self: end;
    padding-top: 2.8rem;
  }

  .generated-token-row span,
  .gpu-output span,
  .fast-token-stream span {
    border-color: rgba(245, 158, 11, 0.36);
    color: #fef3c7;
    background: rgba(146, 64, 14, 0.25);
    animation-name: generatedTokenPop;
  }

  .hardware-grid {
    min-height: 360px;
  }

  .gpu-serving-stack,
  .cerebras-serving-stack {
    min-height: 274px;
  }

  .gpu-serving-stack {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 0.75rem;
  }

  .request-queue span {
    border-color: rgba(148, 163, 184, 0.26);
    color: #cbd5e1;
    animation-name: requestQueuePulse;
  }

  .monolithic-gpu {
    position: relative;
    min-height: 166px;
    padding: 0.9rem;
    border: 1px solid rgba(167, 139, 250, 0.34);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(67, 56, 202, 0.22), rgba(15, 23, 42, 0.92)),
      repeating-linear-gradient(90deg, rgba(148, 163, 184, 0.06), rgba(148, 163, 184, 0.06) 1px, transparent 1px, transparent 14px);
    overflow: hidden;
  }

  .gpu-phase {
    position: absolute;
    left: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    border-radius: 6px;
    color: #f8fafc;
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
  }

  .gpu-prefill {
    top: 44px;
    background: rgba(56, 189, 248, 0.18);
    border: 1px solid rgba(56, 189, 248, 0.36);
    animation: gpuPhaseWork 3.2s ease-in-out infinite;
  }

  .gpu-decode {
    top: 92px;
    background: rgba(245, 158, 11, 0.18);
    border: 1px solid rgba(245, 158, 11, 0.36);
    animation: gpuPhaseWork 3.2s ease-in-out infinite 1.1s;
  }

  .hbm-bus {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 0.75rem;
    height: 18px;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.24);
    overflow: hidden;
  }

  .hbm-bus span {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    font-size: 0.62rem;
    line-height: 1;
  }

  .hbm-bus i {
    position: absolute;
    top: 2px;
    left: -20%;
    width: 28%;
    height: 12px;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, #a78bfa, transparent);
    animation: memoryBusTravel 1.5s linear infinite;
  }

  .hbm-bus i:nth-of-type(2) {
    animation-delay: 0.45s;
  }

  .hbm-bus i:nth-of-type(3) {
    animation-delay: 0.9s;
  }

  .cerebras-serving-stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 80px minmax(0, 1.08fr);
    align-items: center;
    gap: 0.75rem;
  }

  .prefill-node b,
  .wafer-engine b {
    display: block;
    margin-top: 0.45rem;
    color: #94a3b8;
    font-size: 0.72rem;
    font-weight: 500;
  }

  .kv-handoff {
    position: relative;
    min-height: 74px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7dd3fc;
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .kv-handoff::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: linear-gradient(90deg, rgba(34, 197, 94, 0.12), rgba(34, 197, 94, 0.8), rgba(34, 197, 94, 0.12));
  }

  .kv-handoff i {
    position: absolute;
    top: calc(50% - 6px);
    left: 0;
    width: 18px;
    height: 12px;
    border-radius: 999px;
    background: #22c55e;
    box-shadow: 0 0 16px rgba(34, 197, 94, 0.7);
    animation: kvHandoffPacket 2s linear infinite;
  }

  .wafer-engine {
    border-color: rgba(245, 158, 11, 0.42);
    background:
      linear-gradient(180deg, rgba(120, 53, 15, 0.4), rgba(15, 23, 42, 0.92)),
      repeating-linear-gradient(45deg, rgba(245, 158, 11, 0.07), rgba(245, 158, 11, 0.07) 1px, transparent 1px, transparent 12px);
  }

  .wafer-grid i {
    border-color: rgba(245, 158, 11, 0.28);
    background: rgba(245, 158, 11, 0.2);
    animation-name: waferCell;
  }

  .fast-token-stream {
    grid-column: 1 / -1;
    justify-content: flex-end;
  }

  .fast-token-stream span {
    min-width: 2.9rem;
    animation-duration: 2.6s;
    animation-delay: calc(var(--i, 0) * 0.12s);
  }

  @keyframes inferenceTokenPulse {
    0%, 100% {
      opacity: 0.7;
      transform: translateY(0);
      border-color: rgba(148, 163, 184, 0.22);
    }
    35% {
      opacity: 1;
      transform: translateY(-2px);
      border-color: rgba(56, 189, 248, 0.58);
    }
  }

  @keyframes prefillPacket {
    0% {
      opacity: 0;
      transform: translateX(0) scaleX(0.7);
    }
    10% {
      opacity: 1;
    }
    82% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(calc(100% - 24px)) scaleX(1);
    }
  }

  @keyframes inferenceBreathe {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.9;
    }
  }

  @keyframes computeCell {
    0%, 100% {
      background: rgba(56, 189, 248, 0.18);
      transform: scale(1);
    }
    45% {
      background: rgba(56, 189, 248, 0.58);
      transform: scale(1.04);
    }
  }

  @keyframes kvCacheFill {
    0%, 100% {
      transform: scaleX(0.28);
      opacity: 0.58;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  @keyframes decodeStepPulse {
    0%, 100% {
      transform: scale(0.8);
      opacity: 0.62;
    }
    50% {
      transform: scale(1.15);
      opacity: 1;
    }
  }

  @keyframes loopGlow {
    0%, 100% {
      opacity: 0.42;
      filter: drop-shadow(0 0 0 rgba(245, 158, 11, 0));
    }
    50% {
      opacity: 0.95;
      filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.45));
    }
  }

  @keyframes generatedTokenPop {
    0%, 18% {
      opacity: 0.35;
      transform: translateY(4px) scale(0.96);
    }
    38%, 78% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0.62;
      transform: translateY(0) scale(0.98);
    }
  }

  @keyframes requestQueuePulse {
    0%, 100% {
      opacity: 0.58;
      transform: translateX(0);
    }
    50% {
      opacity: 1;
      transform: translateX(8px);
    }
  }

  @keyframes gpuPhaseWork {
    0%, 100% {
      opacity: 0.72;
      box-shadow: none;
    }
    45% {
      opacity: 1;
      box-shadow: 0 0 18px rgba(125, 211, 252, 0.22);
    }
  }

  @keyframes memoryBusTravel {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(430%);
    }
  }

  @keyframes kvHandoffPacket {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(62px);
    }
  }

  @keyframes waferCell {
    0%, 100% {
      background: rgba(245, 158, 11, 0.18);
      transform: scale(1);
    }
    45% {
      background: rgba(245, 158, 11, 0.62);
      transform: scale(1.05);
    }
  }

  @media (max-width: 820px) {
    .post-content .inference-diagram {
      width: 100%;
      margin-left: 0;
      transform: none;
    }

    .inference-diagram__header,
    .inference-phase-grid,
    .hardware-grid {
      display: block;
    }

    .inference-diagram__header span:last-child {
      display: none;
    }

    .inference-panel,
    .hardware-panel {
      border-top: 1px solid rgba(148, 163, 184, 0.16);
    }

    .inference-panel:first-child,
    .hardware-panel:first-child {
      border-top: 0;
    }
  }

  @media (max-width: 540px) {
    .inference-panel,
    .hardware-panel {
      padding: 1rem;
    }

    .prefill-machine,
    .decode-machine,
    .cerebras-serving-stack {
      grid-template-columns: 1fr;
    }

    .parallel-lanes {
      min-height: 92px;
    }

    .decode-loop-line {
      display: none;
    }

    .generated-token-row {
      padding-top: 0;
    }

    .kv-handoff {
      min-height: 46px;
    }

    .kv-handoff i {
      animation-name: kvHandoffPacketMobile;
    }

    .fast-token-stream {
      justify-content: flex-start;
    }
  }

  @keyframes kvHandoffPacketMobile {
    0% {
      opacity: 0;
      transform: translateX(0);
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(calc(92vw - 72px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-content .inference-diagram *,
    .post-content .inference-diagram *::before,
    .post-content .inference-diagram *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
